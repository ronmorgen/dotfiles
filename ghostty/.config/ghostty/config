# ============================================================
# Ghostty Configuration · macOS
# After saving changes, press Cmd+Shift+, to hot reload
# ============================================================

# ---------- Theme ----------
theme = everforest-dark-medium.ghostty

# ---------- Font ----------
font-family = JetBrainsMono Nerd Font
font-size = 12.5
font-thicken = true

# ---------- Window Appearance ----------
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
background-opacity = 0.90
background-blur = 30
window-colorspace = display-p3
unfocused-split-opacity = 0.86
resize-overlay = never

# ---------- Cursor ----------
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
mouse-hide-while-typing = true

# ---------- Native macOS Integration ----------
macos-titlebar-style = transparent
macos-option-as-alt = left
focus-follows-mouse = true

# ---------- Behavior ----------
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
copy-on-select = true
scrollback-limit = 100000
window-save-state = always
window-new-tab-position = current
window-inherit-working-directory = true
quit-after-last-window-closed = true
confirm-close-surface = true

# ---------- Keybindings: Split Panes ----------
keybind = cmd+\=new_split:right
keybind = cmd+shift+\=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# ---------- Keybindings: Prompt Navigation ----------
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ---------- Keybindings: Clear Screen ----------
keybind = cmd+k=clear_screen
