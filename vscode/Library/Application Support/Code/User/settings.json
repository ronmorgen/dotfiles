{
  // BREADCRUMBS SETTINGS
  "breadcrumbs.enabled": false,
  "breadcrumbs.icons": false,
  // CHAT SETTINGS
  "chat.agent.enabled": false,
  "chat.disableAIFeatures": true,
  // DBT SETTINGS
  "dbt.targetName": "prod",
  // DIFF SETTINGS
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  // EDITOR APPEARANCE AND BEHAVIOR
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.colorDecorators": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line-thin",
  "editor.detectIndentation": false,
  "editor.emptySelectionClipboard": false,
  "editor.fontFamily": "'Monaspace Neon Var', 'Fira Code', Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.fontWeight": "500",
  "editor.formatOnPaste": true,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.hover.delay": 1500,
  "editor.lightbulb.enabled": "off",
  "editor.lineHeight": 1.6,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.occurrencesHighlight": "off",
  "editor.overviewRulerBorder": false,
  "editor.renderWhitespace": "boundary",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.selectionHighlight": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "top",
  "editor.stickyScroll.enabled": false,
  "editor.tabCompletion": "onlySnippets",
  "editor.tabSize": 2,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  // EXPLORER SETTINGS
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  // FILE SETTINGS
  "files.autoGuessEncoding": true,
  "files.autoSave": "onWindowChange",
  "files.autoSaveWhenNoErrors": true,
  "files.eol": "\n",
  "files.hotExit": "off",
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/bower_components/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true
  },
  // GITBLAME
  "gitblame.ignoreWhitespace": true,
  "gitblame.infoMessageFormat": "${commit.hash_short}",
  "gitblame.inlineMessageEnabled": true,
  "gitblame.inlineMessageFormat": "${author.name} (${time.ago})",
  "gitblame.inlineMessageMargin": 1,
  "gitblame.statusBarMessageFormat": "${author.name} (${time.ago})",
  // SCM SETTINGS
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,
  "scm.diffDecorations": "gutter",
  "scm.providerCountBadge": "auto",
  "scm.providers.visible": 0,
  "scm.showIncomingChanges": "true",
  "scm.showOutgoingChanges": "true",
  // SEARCH SETTINGS
  "search.actionsPosition": "auto",
  "search.collapseResults": "auto",
  "search.exclude": {
    "**/.git": true,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/out/**": true,
    "**/public": true,
    "**/temp": true
  },
  "search.followSymlinks": false,
  "search.maxResults": null,
  "search.showLineNumbers": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  // SNOWFLAKE SETTINGS
  "snowflake.connectionsConfigFile": "/Users/ronm/.snowflake/config.toml",
  // TERMINAL SETTINGS
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.enableFileLinks": "off",
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.scrollback": 50,
  // WINDOW APPEARANCE AND BEHAVIOR
  "window.closeWhenEmpty": true,
  "window.commandCenter": false,
  "window.dialogStyle": "native",
  "window.nativeTabs": true,
  "window.newWindowDimensions": "inherit",
  "window.restoreFullscreen": true,
  "window.title": "${folderPath} ${separator} ${activeEditorShort}",
  "workbench.colorTheme": "Everforest Pro Dark Vibrant",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.iconTheme": "symbols",
  "workbench.layoutControl.type": "both",
  "workbench.list.smoothScrolling": true,
  "workbench.panel.defaultLocation": "left",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.reduceMotion": "on",
  "workbench.settings.applyToAllProfiles": [
    "workbench.colorCustomizations"
  ],
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.view.alwaysShowHeaderActions": true,
  "claudeCode.preferredLocation": "panel",
  "workbench.editorAssociations": {
    "*.pdf": "default"
  },
  "workbench.activityBar.location": "hidden",
  "python.analysis.typeCheckingMode": "basic",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "extensions.ignoreRecommendations": true
}
