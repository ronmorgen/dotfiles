{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git:log,status,diff,branch,switch)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "preferredNotifChannel": "ghostty"
}
