" Minimal vim config: vim's own defaults, vim-plug, a few plugins and keymaps.

" Sensible defaults shipped with vim (incsearch, scrolloff, mouse, wildmenu,
" syntax, filetype plugins, jump to last cursor position).
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

let s:state = (empty($XDG_STATE_HOME) ? $HOME .. '/.local/state' : $XDG_STATE_HOME) .. '/vim'
let s:data = (empty($XDG_DATA_HOME) ? $HOME .. '/.local/share' : $XDG_DATA_HOME) .. '/vim'

" ---------- Plugins (vim-plug) ----------
" plug.vim and plugins live in $XDG_DATA_HOME/vim, outside this repo.
" Installed automatically on first start; update with :PlugUpdate.
let s:plug = s:data .. '/autoload/plug.vim'
if !filereadable(s:plug)
  silent execute '!curl -fsLo ' .. shellescape(s:plug) .. ' --create-dirs'
        \ .. ' https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
endif
execute 'set runtimepath^=' .. fnameescape(s:data)

call plug#begin(s:data .. '/plugged')
Plug 'sainnhe/everforest'
Plug '/opt/homebrew/opt/fzf'                " fzf's vim plugin, from Homebrew
Plug 'junegunn/fzf.vim'
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-repeat'
Plug 'christoomey/vim-tmux-navigator'
call plug#end()

" Install missing plugins on startup.
autocmd VimEnter * if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
      \ | PlugInstall --sync | source $MYVIMRC | endif

" Built-in packages: .editorconfig support, gc to comment, flash yanked text.
packadd! editorconfig
packadd! comment
packadd! hlyank

" ---------- Options ----------
set number
set hidden
set clipboard=unnamed
set ignorecase smartcase hlsearch
set expandtab shiftwidth=2 softtabstop=2
set splitbelow splitright
set signcolumn=yes
set updatetime=100

" Keep swap, undo and viminfo files out of projects.
call mkdir(s:state .. '/swap', 'p', 0700)
call mkdir(s:state .. '/undo', 'p', 0700)
let &directory = s:state .. '/swap//'
let &undodir = s:state .. '/undo//'
let &viminfofile = s:state .. '/viminfo'
set undofile

" ---------- Statusline ----------
" file [flags] (git branch) ... filetype line:col percent
set laststatus=2
set statusline=%f\ %h%m%r
set statusline+=%{exists('*FugitiveStatusline')?FugitiveStatusline():''}
set statusline+=%=%y\ %l:%c\ %p%%

" ---------- Keymaps ----------
let mapleader = ' '

nnoremap <leader>w <Cmd>write<CR>
nnoremap <leader>q <Cmd>quit<CR>
nnoremap <leader>h <Cmd>nohlsearch<CR>
nnoremap [b <Cmd>bprevious<CR>
nnoremap ]b <Cmd>bnext<CR>

" fzf.vim
nnoremap <leader>f <Cmd>Files<CR>
nnoremap <leader>b <Cmd>Buffers<CR>
nnoremap <leader>/ <Cmd>Rg<CR>
nnoremap <leader>gf <Cmd>GFiles<CR>

" fugitive
nnoremap <leader>gs <Cmd>Git<CR>
nnoremap <leader>gb <Cmd>Git blame<CR>
nnoremap <leader>gd <Cmd>Gdiffsplit<CR>

" Ctrl-h/j/k/l move across vim splits and tmux panes (vim-tmux-navigator).

" ---------- Colors ----------
" Everforest dark medium, matching ghostty.
if &term =~# '^tmux'
  let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
  let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
endif
set termguicolors
set background=dark
let g:everforest_background = 'medium'
silent! colorscheme everforest
